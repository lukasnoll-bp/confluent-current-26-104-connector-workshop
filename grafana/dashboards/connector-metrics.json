  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Is the connector healthy?",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Number of tasks configured for this connector. Each task is an independent worker thread polling the IEC 104 server. Should always match tasks.max in the connector config.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Total Tasks",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "kafka_connect_worker_task_count",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Tasks actively collecting IEC 104 data right now. All tasks should always be Running — any drop to zero means the connector has stopped and data is no longer being collected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Running Tasks",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "count(kafka_connect_task_running_ratio == 1) or vector(0)",
          "legendFormat": "Running",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Tasks temporarily suspended (paused by an operator or by the connector framework). A paused task is not collecting data. Zero is expected during normal operation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Paused Tasks",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "count(kafka_connect_task_pause_ratio == 1) or vector(0)",
          "legendFormat": "Paused",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Tasks that have crashed. Zero is the only acceptable value in production — a non-zero count means data is not being collected and manual intervention is required.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Failed Tasks",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "kafka_connect_worker_task_count - (count(kafka_connect_task_running_ratio == 1) or vector(0)) - (count(kafka_connect_task_pause_ratio == 1) or vector(0))",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Total number of times a task failed to start since the connector was deployed. Zero means the connector has started cleanly every single time — no crashes, no restarts required.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Task Startup Failures",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "kafka_connect_worker_task_startup_failure_total",
          "legendFormat": "Startup Failures",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Fraction of time each task has been in the Running state, sampled continuously (1.0 = fully running, 0.0 = fully stopped). A flat line at 1.0 across the entire time window proves the connector is rock-solid — it has never dropped or restarted during this period.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "running ratio",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": true
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Task Running Ratio — stability over time (flat line at 1.0 = production-grade reliability)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "kafka_connect_task_running_ratio",
          "legendFormat": "{{ connector }} / task {{ task }}",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 },
