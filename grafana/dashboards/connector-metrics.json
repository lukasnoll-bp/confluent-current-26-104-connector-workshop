          "legendFormat": "{{ connector }} / task {{ task }}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Number of IEC 104 events queued internally, waiting to be written to Kafka. Should stay near zero under steady-state load. A persistently growing buffer means Kafka cannot ingest data fast enough — a sign of back-pressure that will eventually cause data loss if left unchecked.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "buffered events",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Internal Buffer Depth  \u00b7  near zero = healthy",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "iec104_source_buffer_current_size{target_id=~\"$target_id\"}",
          "legendFormat": "{{ target_id }}",
          "refId": "A"
        }
      ]
    },

    {
