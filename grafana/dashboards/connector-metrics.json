      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Offset Commit Avg Time  \u00b7  Connector \u2192 Kafka",
