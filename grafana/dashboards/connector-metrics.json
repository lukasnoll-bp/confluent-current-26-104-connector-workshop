    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Percentage of Kafka offset commits that succeeded. 100 % means every single batch of data was durably acknowledged by the Kafka broker. Anything below 100 % indicates potential data loss or message redelivery — not acceptable in a production deployment.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "id": 14,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "Offset Commit Success  \u00b7  100 % = production-safe",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "kafka_connect_task_offset_commit_success_percentage",
          "legendFormat": "{{ connector }}",
          "refId": "A"
        }
      ]
    },

