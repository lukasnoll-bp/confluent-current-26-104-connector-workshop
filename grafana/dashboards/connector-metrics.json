      "title": "How much data is flowing?",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "IEC 104 measurement frames received from the field device per second, measured directly at the protocol level by our custom connector metric. Spikes correspond to interrogation cycles; the steady baseline reflects periodic spontaneous transmissions from the RTU.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "events/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Records Read Rate  \u00b7  IEC 104 \u2192 Connector",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
          "expr": "iec104_source_records_read_rate{target_id=~\"$target_id\"}",
          "legendFormat": "{{ target_id }}",
          "refId": "A"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prom-connect" },
      "description": "Records successfully committed to the Kafka topic per second — the standard Kafka Connect source metric. Compare this with Records Read Rate: both lines should track each other closely. A growing gap means Kafka cannot absorb data as fast as the connector is reading it.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "records/s",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Records Written to Kafka Rate  \u00b7  Connector \u2192 Kafka",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prom-connect" },
