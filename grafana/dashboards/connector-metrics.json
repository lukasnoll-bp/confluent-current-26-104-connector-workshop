    {
      "datasource": { "type": "postgres", "uid": "pg-iec104" },
      "description": "Number of IEC 104 measurements received per Common Address (CA) over time. Each CA identifies a distinct RTU or substation. Each colour is a different station — use this to confirm that all expected field devices are actively sending data into the pipeline.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "messages",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 20,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Messages per RTU (Common Address) over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pg-iec104" },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroup(inserted_at, $__interval, 0) AS time,\n  'CA-' || \"COMMONADDRESS\"::text AS metric,\n  COUNT(*) AS value\nFROM iec104_measurements\nWHERE inserted_at >= $__timeFrom()\n  AND inserted_at <= $__timeTo()\n  AND (\"TARGET_ID\" = ANY(string_to_array('${target_id:csv}', ',')) OR '${target_id:raw}' = '$__all')\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "sql": { "columns": [], "groupBy": [], "limit": 50 }
        }
      ]
    },

    {
      "datasource": { "type": "postgres", "uid": "pg-iec104" },
      "description": "Breakdown of IEC 104 message types arriving over time — for example: M_ME_NC_1 (floating-point measurement), M_ME_NB_1 (scaled integer), M_SP_NA_1 (single-point status). Confirms the connector is capturing the full vocabulary of the IEC 104 protocol, not just a single data type.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "messages",
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          },
