    {
      "datasource": { "type": "postgres", "uid": "pg-iec104" },
      "description": "Fault alarm (M_SP_NA_1, IOA 103). Boolean: false = Normal, true = FAULT.",
      "datasource": { "type": "postgres", "uid": "pg-iec104" },
      "description": "Circuit Breaker A Bay 1 (M_DP_TA_1, IOA 110). Static: ON = closed, OFF = tripped by protection relay.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red",   "index": 0, "text": "⚡ TRIPPED" },
                "1": { "color": "green", "index": 1, "text": "CLOSED" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      },
      "title": "Circuit Breaker (IOA 110)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pg-iec104" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  inserted_at AS time,\n  CASE WHEN \"VALUEBOOLEAN\" = true THEN 1.0 ELSE 0.0 END AS \"Breaker\"\nFROM iec104_measurements\nWHERE \"COMMONADDRESS\" = 1 AND \"IOA\" = 110\nORDER BY inserted_at DESC\nLIMIT 1",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "pg-iec104" },
