        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "title": "Fault Alarm (IOA 103)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pg-iec104" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  inserted_at AS time,\n  CASE WHEN \"VALUEBOOLEAN\" = true THEN 1.0 ELSE 0.0 END AS \"Alarm\"\nFROM iec104_measurements\nWHERE \"COMMONADDRESS\" = 1 AND \"IOA\" = 103\nORDER BY inserted_at DESC\nLIMIT 1",
          "refId": "A"
        }
      ]
    },
